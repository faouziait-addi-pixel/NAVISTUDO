rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['userId', 'isAnonymous', 'createdAt'])
        && request.resource.data.keys().hasOnly(['userId', 'isAnonymous', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isAnonymous is bool
        && request.resource.data.createdAt is string
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string);

      allow update: if isOwner(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isAnonymous is bool;

      allow delete: if isOwner(userId);

      match /submissions/{submissionId} {
        allow get: if isOwner(userId) && isValidId(submissionId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(submissionId)
          && request.resource.data.keys().hasAll(['id', 'userId', 'stageId', 'payloadJson', 'createdAt'])
          && request.resource.data.keys().hasOnly(['id', 'userId', 'stageId', 'branchId', 'payloadJson', 'createdAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.payloadJson is string
          && request.resource.data.payloadJson.size() < 100000;

        allow update: if false; // submissions are immutable snapshots
        allow delete: if isOwner(userId) && isValidId(submissionId);
      }

      match /bookmarks/{majorId} {
        allow get: if isOwner(userId) && isValidId(majorId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(majorId)
          && request.resource.data.keys().hasAll(['majorId', 'userId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['majorId', 'userId', 'savedAt'])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.majorId == majorId;

        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(majorId);
      }
    }
  }
}
